<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/buttons_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="4dp"
    android:paddingBottom="12dp">

    <app.aaps.core.ui.elements.SingleClickButton
        android:id="@+id/accept_temp_button"
        style="@style/ButtonSmallFontStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="5dp"
        android:paddingEnd="5dp"
        android:text="@string/set_basal_question"
        android:textColor="?attr/acceptTempButtonColor"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/user_buttons_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="@dimen/gray_material_button_margin_horizontal"
        android:paddingEnd="@dimen/gray_material_button_margin_horizontal" />

    <com.google.android.flexbox.FlexboxLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/secondary_actions_layout"
        app:alignItems="center"
        app:flexWrap="wrap"
        app:justifyContent="center">

        <app.aaps.core.ui.elements.SingleClickButton
            android:id="@+id/treatment_button"
            style="@style/OverviewSecondaryAction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/overview_treatment_label"
            android:textColor="?attr/icTreatmentColor"
            android:visibility="gone" />

        <app.aaps.core.ui.elements.SingleClickButton
            android:id="@+id/carbs_button"
            style="@style/OverviewSecondaryAction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/overview_record_carbs"
            android:textColor="?attr/icBolusCarbsColor" />

        <app.aaps.core.ui.elements.SingleClickButton
            android:id="@+id/wizard_button"
            style="@style/OverviewSecondaryAction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/calculator_label"
            android:textColor="?attr/icCalculatorColor" />

        <app.aaps.core.ui.elements.SingleClickButton
            android:id="@+id/calibration_button"
            style="@style/OverviewSecondaryAction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/calibration"
            android:textColor="?attr/icCalibrationColor"
            android:visibility="gone" />

        <app.aaps.core.ui.elements.SingleClickButton
            android:id="@+id/cgm_button"
            style="@style/OverviewSecondaryAction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/overview_cgm"
            android:textColor="?attr/icCalibrationColor"
            android:visibility="gone" />

        <app.aaps.core.ui.elements.SingleClickButton
            android:id="@+id/quick_wizard_button"
            style="@style/OverviewSecondaryAction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:hint="@string/quickwizard"
            android:text="@string/quickwizard"
            android:textColor="?attr/icQuickWizardColor" />

    </com.google.android.flexbox.FlexboxLayout>

    <LinearLayout
        android:id="@+id/primary_actions_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/insulin_action_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:layout_weight="1">

            <app.aaps.core.ui.elements.SingleClickButton
                android:id="@+id/insulin_button"
                style="@style/OverviewPrimaryAction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/overview_enter_insulin"
                android:textColor="?attr/icBolusColor"
                android:maxLines="2"
                android:visibility="gone"
                app:icon="@drawable/ic_bolus"
                app:iconTint="?attr/icBolusColor"
                app:strokeColor="?attr/icBolusColor" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/insulin_unavailable_button"
                style="@style/OverviewPrimaryAction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/overview_enter_insulin"
                android:textColor="?android:attr/textColorSecondary"
                android:maxLines="2"
                app:icon="@drawable/ic_bolus"
                app:iconTint="?android:attr/textColorSecondary"
                app:strokeColor="?android:attr/textColorSecondary"
                android:alpha="0.5"
                android:enabled="false"
                android:contentDescription="@string/overview_insulin_action_unavailable" />

        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1">

            <app.aaps.core.ui.elements.SingleClickButton
                android:id="@+id/meal_entry_button"
                style="@style/OverviewPrimaryAction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/overview_enter_carbs"
                android:textColor="?attr/icBolusCarbsColor"
                android:maxLines="2"
                android:visibility="gone"
                app:icon="@drawable/ic_cp_bolus_carbs"
                app:iconTint="?attr/icBolusCarbsColor"
                app:strokeColor="?attr/icBolusCarbsColor"
                android:contentDescription="@string/overview_enter_carbs_description" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/meal_unavailable_button"
                style="@style/OverviewPrimaryAction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/overview_enter_carbs"
                android:textColor="?android:attr/textColorSecondary"
                android:maxLines="2"
                app:icon="@drawable/ic_cp_bolus_carbs"
                app:iconTint="?android:attr/textColorSecondary"
                app:strokeColor="?android:attr/textColorSecondary"
                android:contentDescription="@string/overview_carbs_action_unavailable"
                android:alpha="0.5"
                android:enabled="false" />

        </FrameLayout>

    </LinearLayout>

</LinearLayout>
