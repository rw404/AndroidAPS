<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/buttons_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/healfi_canvas"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="16dp">

    <!-- These controls are bound here, then moved into scrolling content. -->
    <app.aaps.core.ui.elements.SingleClickButton
        android:id="@+id/accept_temp_button"
        style="@style/HealfiMealButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/set_basal_question"
        android:textColor="?attr/acceptTempButtonColor"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/user_buttons_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="@dimen/gray_material_button_margin_horizontal"
        android:paddingEnd="@dimen/gray_material_button_margin_horizontal" />

    <com.google.android.flexbox.FlexboxLayout
        android:id="@+id/secondary_actions_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:alignItems="center"
        app:flexWrap="wrap"
        app:justifyContent="flex_start">

        <app.aaps.core.ui.elements.SingleClickButton
            android:id="@+id/treatment_button"
            style="@style/HealfiSecondaryButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/overview_treatment_label"
            android:visibility="gone" />

        <app.aaps.core.ui.elements.SingleClickButton
            android:id="@+id/carbs_button"
            style="@style/HealfiSecondaryButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/overview_record_carbs" />

        <app.aaps.core.ui.elements.SingleClickButton
            android:id="@+id/wizard_button"
            style="@style/HealfiSecondaryButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/calculator_label" />

        <app.aaps.core.ui.elements.SingleClickButton
            android:id="@+id/calibration_button"
            style="@style/HealfiSecondaryButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/calibration"
            android:visibility="gone" />

        <app.aaps.core.ui.elements.SingleClickButton
            android:id="@+id/cgm_button"
            style="@style/HealfiSecondaryButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/overview_cgm"
            android:visibility="gone" />

        <app.aaps.core.ui.elements.SingleClickButton
            android:id="@+id/quick_wizard_button"
            style="@style/HealfiSecondaryButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:hint="@string/quickwizard"
            android:text="@string/quickwizard" />

    </com.google.android.flexbox.FlexboxLayout>

    <LinearLayout
        android:id="@+id/primary_actions_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/insulin_action_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="5dp"
            android:layout_weight="1">

            <app.aaps.core.ui.elements.SingleClickButton
                android:id="@+id/insulin_button"
                style="@style/HealfiPrimaryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="64dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:maxLines="2"
                android:text="@string/overview_enter_insulin"
                android:visibility="gone"
                app:icon="@drawable/healfi_ic_insulin" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/insulin_unavailable_button"
                style="@style/HealfiPrimaryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="64dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:maxLines="2"
                android:text="@string/overview_enter_insulin"
                android:alpha="0.45"
                android:enabled="false"
                android:contentDescription="@string/overview_insulin_action_unavailable"
                app:icon="@drawable/healfi_ic_insulin" />

        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:layout_weight="1">

            <app.aaps.core.ui.elements.SingleClickButton
                android:id="@+id/meal_entry_button"
                style="@style/HealfiMealButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="64dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:maxLines="2"
                android:text="@string/overview_enter_carbs"
                android:visibility="gone"
                android:contentDescription="@string/overview_enter_carbs_description"
                app:icon="@drawable/healfi_ic_meal" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/meal_unavailable_button"
                style="@style/HealfiMealButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="64dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:maxLines="2"
                android:text="@string/overview_enter_carbs"
                android:alpha="0.45"
                android:enabled="false"
                android:contentDescription="@string/overview_carbs_action_unavailable"
                app:icon="@drawable/healfi_ic_meal" />

        </FrameLayout>

    </LinearLayout>

</LinearLayout>
