        <TextView android:id="@+id/base_basal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textAppearance="@style/HealfiValue" android:maxLines="4" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="14sp" android:autoSizeMaxTextSize="22sp" android:autoSizeStepGranularity="1sp" />
