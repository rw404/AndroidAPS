    <TextView android:id="@+id/version" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textAppearance="@style/HealfiLabel" android:visibility="gone" />
    <androidx.constraintlayout.helper.widget.Flow android:id="@+id/overview_metrics" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
</androidx.constraintlayout.widget.ConstraintLayout>