<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Overview-only surfaces follow the active light or dark app theme. -->
    <style name="OverviewCard" parent="Widget.MaterialComponents.CardView">
        <item name="android:layout_marginTop">12dp</item>
        <item name="cardBackgroundColor">?attr/colorSurface</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardUseCompatPadding">false</item>
        <item name="contentPadding">12dp</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="OverviewContextCard" parent="OverviewCard">
        <item name="android:layout_marginTop">0dp</item>
        <item name="contentPadding">0dp</item>
    </style>

    <style name="OverviewMetricLabel" parent="TextAppearance.AppCompat.Small">
        <item name="android:textColor">?android:attr/textColorSecondary</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="OverviewMetricValue" parent="TextAppearance.AppCompat.Medium">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="OverviewPrimaryAction" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:minHeight">64dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="backgroundTint">?attr/colorSurface</item>
        <item name="cornerRadius">16dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="iconSize">22dp</item>
        <item name="iconPadding">8dp</item>
        <item name="iconGravity">textStart</item>
    </style>

    <style name="OverviewSecondaryAction" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textColor">?attr/defaultTextColor</item>
    </style>

</resources>
