<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Healfi.Main" parent="AppTheme.NoActionBar">
        <item name="colorPrimary">@color/healfi_shell_accent</item>
        <item name="colorPrimaryDark">@color/healfi_shell_surface</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorSecondary">@color/healfi_shell_accent</item>
        <item name="colorOnSecondary">@android:color/white</item>
        <item name="colorAccent">@color/healfi_shell_accent</item>
        <item name="colorControlNormal">@color/healfi_shell_ink</item>
        <item name="colorSurface">@color/healfi_shell_surface</item>
        <item name="colorOnSurface">@color/healfi_shell_ink</item>
        <item name="colorOnBackground">@color/healfi_shell_ink</item>
        <item name="graphGrid">@color/healfi_shell_border</item>
        <item name="viewPortBackgroundColor">@color/healfi_shell_surface</item>
        <item name="defaultTextColor">@color/healfi_shell_ink</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorBackground">@color/healfi_shell_background</item>
        <item name="android:windowBackground">@color/healfi_shell_background</item>
        <item name="android:textColorPrimary">@color/healfi_shell_ink</item>
        <item name="android:textColorSecondary">@color/healfi_shell_muted</item>
        <item name="android:statusBarColor">@color/healfi_shell_surface</item>
        <item name="android:navigationBarColor">@color/healfi_shell_surface</item>
        <item name="android:windowLightStatusBar">@bool/healfi_shell_light_system_bars</item>
        <item name="android:windowLightNavigationBar">@bool/healfi_shell_light_system_bars</item>
    </style>

    <style name="healfi_shell_toolbar_theme" parent="ThemeOverlay.MaterialComponents.ActionBar">
        <item name="android:textColorPrimary">@color/healfi_shell_ink</item>
        <item name="colorControlNormal">@color/healfi_shell_ink</item>
    </style>

    <style name="healfi_shell_toolbar_title" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="healfi_shell_tab_text" parent="TextAppearance.MaterialComponents.Button">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="healfi_shell_drawer_text" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">15sp</item>
    </style>
</resources>
