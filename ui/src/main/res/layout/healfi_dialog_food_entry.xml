<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/healfi_scenario_canvas" android:padding="16dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView style="@style/HealfiScenario.Title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/healfi_food_title" />
        <com.google.android.material.button.MaterialButton android:id="@+id/cancel_button" style="@style/HealfiScenario.TertiaryButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/cancel" />
    </LinearLayout>
    <TextView android:id="@+id/healfi_food_stage" style="@style/HealfiScenario.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:text="@string/healfi_food_stage_find" />
    <androidx.core.widget.NestedScrollView android:id="@+id/food_scroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:clipToPadding="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="16dp">
            <LinearLayout android:id="@+id/healfi_food_find_panel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <EditText android:id="@+id/query" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:hint="@string/food_entry_query" android:inputType="textCapSentences|textMultiLine" android:imeOptions="actionSearch" android:maxLines="3" android:maxLength="1000" style="@style/HealfiScenario.TextInput" android:layout_marginTop="4dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/search_button" style="@style/HealfiScenario.SecondaryButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/food_entry_find" android:layout_marginTop="8dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/healfi_food_methods_toggle" style="@style/HealfiScenario.TertiaryButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="start|center_vertical" android:text="@string/healfi_food_methods_show" />
                <LinearLayout android:id="@+id/healfi_food_methods_panel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                    <com.google.android.material.button.MaterialButtonToggleGroup android:id="@+id/input_modes" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="0dp" app:checkedButton="@id/mode_search" app:selectionRequired="true" app:singleSelection="true">
                        <com.google.android.material.button.MaterialButton android:id="@+id/mode_search" style="@style/HealfiScenario.SecondaryButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/food_entry_search_mode" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/mode_text" style="@style/HealfiScenario.SecondaryButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/food_entry_text_mode" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/mode_photo" style="@style/HealfiScenario.SecondaryButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/food_entry_photo_mode" />
                    </com.google.android.material.button.MaterialButtonToggleGroup>
                    <TextView style="@style/HealfiScenario.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/food_entry_local" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/photo_button" style="@style/HealfiScenario.SecondaryButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/food_entry_choose_photo" android:visibility="gone" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/manual_button" style="@style/HealfiScenario.TertiaryButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:textAllCaps="false" android:text="@string/food_entry_manual" android:gravity="start|center_vertical" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/label_toggle" style="@style/HealfiScenario.TertiaryButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/food_entry_manual_label" android:gravity="start|center_vertical" />
                </LinearLayout>
                <TextView android:id="@+id/mode_hint" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/food_entry_search_hint" style="@style/HealfiScenario.Label" />
            </LinearLayout>
            <ProgressBar android:id="@+id/progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:indeterminate="true" android:visibility="gone" />
            <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:accessibilityLiveRegion="polite" android:paddingTop="8dp" android:paddingBottom="8dp" style="@style/HealfiScenario.Label" />
            <TextView android:id="@+id/component_hint" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" style="@style/HealfiScenario.Body" />
            <com.google.android.material.button.MaterialButton android:id="@+id/reset_description" style="@style/HealfiScenario.TertiaryButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/food_entry_reset_description" android:visibility="gone" />
            <TextView android:id="@+id/barcode_hint" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/food_entry_barcode_network" android:visibility="gone" style="@style/HealfiScenario.Body" />
            <com.google.android.material.button.MaterialButton android:id="@+id/barcode_button" style="@style/HealfiScenario.SecondaryButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/food_entry_barcode_lookup" android:visibility="gone" />
            <LinearLayout android:id="@+id/dish_suggestions" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
            <LinearLayout android:id="@+id/search_results" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
            <com.google.android.material.card.MaterialCardView android:id="@+id/label_editor" style="@style/HealfiScenario.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:visibility="gone" android:layout_marginBottom="12dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/food_entry_label_title" android:textStyle="bold" style="@style/HealfiScenario.Body" />
                    <EditText android:id="@+id/label_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:hint="@string/food_entry_label_name" android:inputType="textCapSentences" android:maxLength="200" style="@style/HealfiScenario.TextInput" />
                    <EditText android:id="@+id/label_carbs" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:hint="@string/food_entry_label_carbs" android:inputType="numberDecimal" android:maxLength="64" style="@style/HealfiScenario.TextInput" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:labelFor="@id/label_basis" android:text="@string/food_entry_label_basis" style="@style/HealfiScenario.Body" />
                    <Spinner android:id="@+id/label_basis" android:layout_width="match_parent" android:layout_height="48dp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:labelFor="@id/label_definition" android:text="@string/food_entry_label_definition" style="@style/HealfiScenario.Body" />
                    <Spinner android:id="@+id/label_definition" android:layout_width="match_parent" android:layout_height="48dp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:labelFor="@id/label_preparation" android:text="@string/food_entry_label_preparation" style="@style/HealfiScenario.Body" />
                    <Spinner android:id="@+id/label_preparation" android:layout_width="match_parent" android:layout_height="48dp" />
                    <TextView android:id="@+id/ocr_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="8" android:ellipsize="end" android:textIsSelectable="true" style="@style/HealfiScenario.Body" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/use_label_button" style="@style/HealfiScenario.SecondaryButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/food_entry_use_label" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView android:id="@+id/selected_card" style="@style/HealfiScenario.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="0dp">
                    <TextView android:id="@+id/food_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="sans-serif-medium" style="@style/HealfiScenario.Section" />
                    <TextView android:id="@+id/food_preparation" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" style="@style/HealfiScenario.Label" />
                    <TextView android:id="@+id/food_source" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textIsSelectable="true" style="@style/HealfiScenario.Label" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/healfi_food_source_toggle" style="@style/HealfiScenario.TertiaryButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="start|center_vertical" android:text="@string/healfi_food_source_show" />
                    <TextView android:id="@+id/healfi_food_source_details" style="@style/HealfiScenario.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:textIsSelectable="true" android:visibility="gone" />
                    <TextView android:id="@+id/food_basis" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" style="@style/HealfiScenario.Label" />
                    <TextView style="@style/HealfiScenario.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:labelFor="@id/amount" android:text="@string/healfi_food_amount_hint" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="4dp">
                        <EditText android:id="@+id/amount" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:minHeight="48dp" android:hint="@string/healfi_food_amount_placeholder" android:inputType="numberDecimal" android:maxLength="64" style="@style/HealfiScenario.TextInput" android:textSize="28sp" />
                        <Spinner android:id="@+id/portion_unit" android:layout_width="96dp" android:layout_height="48dp" android:contentDescription="@string/units_label" android:layout_marginStart="8dp" />
                    </LinearLayout>
                    <TextView android:id="@+id/portion_preview" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:accessibilityLiveRegion="polite" style="@style/HealfiScenario.Value" android:textSize="20sp" />
                    <com.google.android.material.checkbox.MaterialCheckBox android:id="@+id/source_checked" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/food_entry_checked" android:textSize="14sp" android:layout_marginTop="8dp" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/add_button" style="@style/HealfiScenario.SecondaryButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:enabled="false" android:text="@string/healfi_food_add_another" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/discard_selection" style="@style/HealfiScenario.TertiaryButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/healfi_food_choose_another" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <LinearLayout android:id="@+id/healfi_food_meal_panel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="16dp" android:visibility="gone">
                <TextView style="@style/HealfiScenario.Section" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/food_entry_basket" />
                <LinearLayout android:id="@+id/meal_items" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="8dp">
        <TextView android:id="@+id/meal_total" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="0dp" android:layout_marginBottom="4dp" style="@style/HealfiScenario.Body" android:accessibilityLiveRegion="polite" />
        <TextView style="@style/HealfiScenario.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:text="@string/healfi_food_draft_note" />
        <com.google.android.material.button.MaterialButton android:id="@+id/continue_button" style="@style/HealfiScenario.PrimaryButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:enabled="false" android:text="@string/healfi_food_review" />
    </LinearLayout>
</LinearLayout>
