<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:ns1="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" ns1:context=".activities.TreatmentsActivity" android:background="@color/healfi_scenario_canvas">
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="?attr/actionBarSize" android:background="@color/healfi_scenario_surface" android:paddingStart="8dp" app:titleTextAppearance="@style/HealfiScenario.Section" />
    <com.google.android.material.tabs.TabLayout android:id="@+id/treatments_tabs" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone">
        <com.google.android.material.tabs.TabItem android:layout_width="wrap_content" android:layout_height="wrap_content" android:contentDescription="@string/bolus" android:icon="@drawable/ic_cp_bolus_carbs" />
        <com.google.android.material.tabs.TabItem android:layout_width="wrap_content" android:layout_height="wrap_content" android:contentDescription="@string/extended_bolus" android:icon="@drawable/ic_actions_start_extended_bolus" />
        <com.google.android.material.tabs.TabItem android:layout_width="wrap_content" android:layout_height="wrap_content" android:contentDescription="@string/tempbasal_label" android:icon="@drawable/ic_actions_start_temp_basal" />
        <com.google.android.material.tabs.TabItem android:layout_width="wrap_content" android:layout_height="wrap_content" android:contentDescription="@string/temporary_target" android:icon="@drawable/ic_temptarget_high" />
        <com.google.android.material.tabs.TabItem android:layout_width="wrap_content" android:layout_height="wrap_content" android:contentDescription="@string/careportal_profileswitch" android:icon="@drawable/ic_actions_profileswitch" />
        <com.google.android.material.tabs.TabItem android:layout_width="wrap_content" android:layout_height="wrap_content" android:contentDescription="@string/careportal" android:icon="@drawable/ic_cp_note" />
        <com.google.android.material.tabs.TabItem android:layout_width="wrap_content" android:layout_height="wrap_content" android:contentDescription="@string/running_mode" android:icon="@drawable/ic_running_mode" />
        <com.google.android.material.tabs.TabItem android:layout_width="wrap_content" android:layout_height="wrap_content" android:contentDescription="@string/user_entry" android:icon="@drawable/ic_user_options" />
    </com.google.android.material.tabs.TabLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingHorizontal="16dp" android:paddingTop="8dp" android:baselineAligned="false">
        <com.google.android.material.button.MaterialButton style="@style/HealfiScenario.SecondaryButton" android:id="@+id/healfi_history_primary" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/healfi_history_food_insulin" />
        <com.google.android.material.button.MaterialButton style="@style/HealfiScenario.TertiaryButton" android:id="@+id/healfi_history_more" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/healfi_history_other_events" />
    </LinearLayout>
    <FrameLayout android:id="@+id/fragment_container" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
    <com.google.android.material.button.MaterialButton style="@style/HealfiScenario.TertiaryButton" android:id="@+id/healfi_history_glucose" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/healfi_history_glucose_label" />
</LinearLayout>
