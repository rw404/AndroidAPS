<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/food_entry_title"
        android:textSize="24sp"
        android:fontFamily="sans-serif-medium" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/food_entry_local"
        android:textAppearance="@style/TextAppearance.AppCompat.Small" />

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/input_modes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:checkedButton="@id/mode_search"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/mode_search"
            style="@style/FoodEntryButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/food_entry_search_mode" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/mode_text"
            style="@style/FoodEntryButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/food_entry_text_mode" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/mode_photo"
            style="@style/FoodEntryButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/food_entry_photo_mode" />

    </com.google.android.material.button.MaterialButtonToggleGroup>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/food_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/mode_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/food_entry_search_hint" />

            <EditText
                android:id="@+id/query"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:hint="@string/food_entry_query"
                android:inputType="textCapSentences|textMultiLine"
                android:imeOptions="actionSearch"
                android:maxLines="3"
                android:maxLength="1000" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/search_button"
                style="@style/FoodEntryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/food_entry_find" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/photo_button"
                style="@style/FoodEntryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/food_entry_choose_photo"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:indeterminate="true"
                android:visibility="gone" />

            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityLiveRegion="polite"
                android:paddingTop="8dp"
                android:paddingBottom="8dp" />

            <TextView
                android:id="@+id/component_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/reset_description"
                style="@style/FoodEntryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/food_entry_reset_description"
                android:visibility="gone" />

            <TextView
                android:id="@+id/barcode_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/food_entry_barcode_network"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/barcode_button"
                style="@style/FoodEntryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/food_entry_barcode_lookup"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/dish_suggestions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <LinearLayout
                android:id="@+id/search_results"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/label_toggle"
                style="@style/FoodEntryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/food_entry_manual_label" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/label_editor"
                style="@style/FoodEntryCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/food_entry_label_title"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/label_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:hint="@string/food_entry_label_name"
                        android:inputType="textCapSentences"
                        android:maxLength="200" />

                    <EditText
                        android:id="@+id/label_carbs"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:hint="@string/food_entry_label_carbs"
                        android:inputType="numberDecimal"
                        android:maxLength="64" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:labelFor="@id/label_basis"
                        android:text="@string/food_entry_label_basis" />

                    <Spinner
                        android:id="@+id/label_basis"
                        android:layout_width="match_parent"
                        android:layout_height="48dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:labelFor="@id/label_definition"
                        android:text="@string/food_entry_label_definition" />

                    <Spinner
                        android:id="@+id/label_definition"
                        android:layout_width="match_parent"
                        android:layout_height="48dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:labelFor="@id/label_preparation"
                        android:text="@string/food_entry_label_preparation" />

                    <Spinner
                        android:id="@+id/label_preparation"
                        android:layout_width="match_parent"
                        android:layout_height="48dp" />

                    <TextView
                        android:id="@+id/ocr_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxLines="8"
                        android:ellipsize="end"
                        android:textIsSelectable="true" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/use_label_button"
                        style="@style/FoodEntryButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/food_entry_use_label" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/selected_card"
                style="@style/FoodEntryCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/food_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="20sp"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:id="@+id/food_source"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textIsSelectable="true" />

                    <TextView
                        android:id="@+id/food_preparation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" />

                    <TextView
                        android:id="@+id/food_basis"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/amount"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:minHeight="48dp"
                            android:hint="@string/food_entry_amount"
                            android:inputType="numberDecimal"
                            android:maxLength="64" />

                        <Spinner
                            android:id="@+id/portion_unit"
                            android:layout_width="96dp"
                            android:layout_height="48dp"
                            android:contentDescription="@string/units_label" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/portion_preview"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:accessibilityLiveRegion="polite" />

                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/source_checked"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/food_entry_checked" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/discard_selection"
                        style="@style/FoodEntryButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/food_entry_discard_selection" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/add_button"
                        style="@style/FoodEntryButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:enabled="false"
                        android:text="@string/food_entry_add" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/food_entry_basket"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/meal_items"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/meal_total"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="12dp"
                android:textAppearance="@style/TextAppearance.AppCompat.Medium" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:text="@string/food_entry_profile_hint"
        android:textAppearance="@style/TextAppearance.AppCompat.Small" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/continue_button"
        style="@style/FoodEntryButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:enabled="false"
        android:text="@string/food_entry_continue" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/manual_button"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:textAllCaps="false"
        android:text="@string/food_entry_manual" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/cancel_button"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:textAllCaps="false"
        android:text="@string/cancel" />

</LinearLayout>
